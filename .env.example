# SkillItLearn Environment Variables
# Copy this to .env.local for local development
# For Vercel: add these in Settings > Environment Variables

# ── Supabase ────────────────────────────────────────────
# Public (safe for client - prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Private (server-only - NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── Database (Prisma) ──────────────────────────────────
# Connection pooling URL (for serverless)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection URL (for migrations)
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=25458759759-10pgpn8jh2hbare4p7umssertaga0sdf.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Site URL ───────────────────────────────────────────
# Set to your production domain on Vercel
NEXT_PUBLIC_SITE_URL=https://skillitlearn.vercel.app

# ── Certificate Security ──────────────────────────────
# HMAC secret for certificate verification hashes
# WARNING: Never rotate this without re-issuing ALL existing certificates
CERTIFICATE_SECRET=your-strong-random-secret-min-32-chars
