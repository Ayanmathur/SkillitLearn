generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  learner
  instructor
  admin
  super_admin
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  role      UserRole @default(learner)
  createdAt DateTime @default(now()) @map("created_at")

  createdCareers   Career[]
  learnerProgress  LearnerProgress[]
  quizAttempts     QuizAttempt[]
  skillCompletions SkillCompletion[]
  certificates     Certificate[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Career {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String
  iconUrl     String?  @map("icon_url")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  creator User   @relation(fields: [createdBy], references: [id])
  paths   Path[]

  @@index([slug])
  @@map("careers")
}

model Path {
  id          String   @id @default(uuid()) @db.Uuid
  careerId    String   @map("career_id") @db.Uuid
  name        String
  slug        String   @unique
  description String
  orderIndex  Int      @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  career              Career                  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skills              Skill[]
  certificateTemplate PathCertificateTemplate?
  certificates        Certificate[]

  @@index([slug])
  @@index([careerId])
  @@map("career_paths")
}

model Skill {
  id             String  @id @default(uuid()) @db.Uuid
  pathId         String  @map("path_id") @db.Uuid
  name           String
  slug           String  @unique
  description    String
  orderIndex     Int     @map("order_index")
  estimatedHours Float   @map("estimated_hours")

  path             Path              @relation(fields: [pathId], references: [id], onDelete: Cascade)
  tracks           Track[]
  quizQuestions    QuizQuestion[]
  quizAttempts     QuizAttempt[]
  skillCompletions SkillCompletion[]

  @@index([slug])
  @@index([pathId])
  @@map("skills")
}

model Track {
  id         String @id @default(uuid()) @db.Uuid
  skillId    String @map("skill_id") @db.Uuid
  title      String
  orderIndex Int    @map("order_index")

  skill Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  steps Step[]

  @@index([skillId])
  @@map("modules")
}

model Step {
  id         String   @id @default(uuid()) @db.Uuid
  trackId    String   @map("module_id") @db.Uuid
  title      String
  content    String   @db.Text
  mediaUrls  String[] @map("media_urls")
  orderIndex Int      @map("order_index")

  track           Track             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  learnerProgress LearnerProgress[]

  @@index([trackId])
  @@map("steps")
}

model LearnerProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  stepId      String   @map("step_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
  @@index([stepId])
  @@map("learner_progress")
}

model QuizQuestion {
  id              String @id @default(uuid()) @db.Uuid
  skillId         String @map("skill_id") @db.Uuid
  questionText    String @map("question_text") @db.Text
  choicesJson     Json   @map("choices_json")
  correctChoiceId String @map("correct_choice_id")
  explanation     String @db.Text
  orderIndex      Int    @map("order_index")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  score       Float
  passed      Boolean
  answersJson Json     @map("answers_json")
  attemptedAt DateTime @default(now()) @map("attempted_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([skillId])
  @@index([userId, skillId])
  @@map("quiz_attempts")
}

model SkillCompletion {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  skillId        String    @map("skill_id") @db.Uuid
  stepsCompleted Boolean   @default(false) @map("steps_completed")
  quizPassed     Boolean   @default(false) @map("quiz_passed")
  completedAt    DateTime? @map("completed_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("skill_completion")
}

model PathCertificateTemplate {
  id                 String  @id @default(uuid()) @db.Uuid
  pathId             String  @unique @map("path_id") @db.Uuid
  logoUrl            String? @map("logo_url")
  signatureUrl       String? @map("signature_url")
  signatoryName      String? @map("signatory_name")
  signatoryTitle     String? @map("signatory_title")
  templateLayoutJson Json?   @map("template_layout_json")

  path Path @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@map("path_certificate_templates")
}

model Certificate {
  id                  String   @id @default(uuid()) @db.Uuid
  uniqueCertificateId String   @unique @map("unique_certificate_id")
  userId              String   @map("user_id") @db.Uuid
  pathId              String   @map("path_id") @db.Uuid
  issuedAt            DateTime @default(now()) @map("issued_at")
  qrCodeUrl           String?  @map("qr_code_url")
  pdfUrl              String?  @map("pdf_url")
  verificationHash    String   @map("verification_hash")
  revoked             Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  path Path @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@index([uniqueCertificateId])
  @@index([userId])
  @@index([pathId])
  @@map("certificates")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  targetTable  String   @map("target_table")
  targetId     String   @map("target_id")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetTable, targetId])
  @@index([createdAt])
  @@map("audit_log")
}
